<?xml version="1.0" encoding="utf-8"?>
<!--
  账然 v0.1 Manifest（T1a）

  权限红线（依据 docs/07 §9、docs/08 §17.3）：本任务仍**零权限**。
  不得出现：INTERNET / ACCESS_NETWORK_STATE / BIND_NOTIFICATION_LISTENER_SERVICE /
  BIND_ACCESSIBILITY_SERVICE / RECEIVE_SMS / READ_SMS / QUERY_ALL_PACKAGES /
  FOREGROUND_SERVICE(*_SPECIAL_USE) / SYSTEM_ALERT_WINDOW。
  （单 APK 后这些权限最终由账然声明，属 U3；U0 不得新增。）

  组件：只有启动 Activity。原 `zhangran://capture` 接收入口（CaptureEntryActivity）
  已按 D7 删除——进程内接口不需要任何可导出组件（docs/07 §3.5）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ZhangRanApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhangRan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ZhangRan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
